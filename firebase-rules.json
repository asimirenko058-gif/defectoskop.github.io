{
  "rules": {
    "messages": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || auth.uid === 'ADMIN_UID')))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts']) && newData.child('uid').val() === auth.uid && newData.child('ts').val() === now && newData.parent().parent().child('last').child(auth.uid).val() === now",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "last": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || newData.val() >= data.val() + 3000)"
      }
    },
    "online": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "banned": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'ADMIN_UID')",
        ".write": "auth != null && auth.uid === 'ADMIN_UID'",
        ".validate": "newData.val() === true"
      }
    }
  }
}
